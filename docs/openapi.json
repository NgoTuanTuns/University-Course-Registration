{
  "components": {
    "schemas": {
      "CourseCreate": {
        "properties": {
          "code": {
            "description": "Mã học phần (duy nhất, ví dụ INT131)",
            "maxLength": 20,
            "minLength": 1,
            "title": "Code",
            "type": "string"
          },
          "credits": {
            "description": "Số tín chỉ (1 - 10)",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Credits",
            "type": "integer"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Mô tả học phần",
            "title": "Description"
          },
          "name": {
            "description": "Tên học phần",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "code",
          "name",
          "credits"
        ],
        "title": "CourseCreate",
        "type": "object"
      },
      "CourseListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CourseOut"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "title": "Page Size",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "page_size"
        ],
        "title": "CourseListResponse",
        "type": "object"
      },
      "CourseOut": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "credits": {
            "title": "Credits",
            "type": "integer"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "code",
          "name",
          "credits",
          "description",
          "created_at"
        ],
        "title": "CourseOut",
        "type": "object"
      },
      "CourseUpdate": {
        "properties": {
          "credits": {
            "anyOf": [
              {
                "maximum": 10.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Số tín chỉ (1 - 10)",
            "title": "Credits"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Mô tả học phần",
            "title": "Description"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Tên học phần",
            "title": "Name"
          }
        },
        "title": "CourseUpdate",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "maxLength": 255,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "MessageResponse": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "MessageResponse",
        "type": "object"
      },
      "MissingCourseOut": {
        "properties": {
          "course_code": {
            "title": "Course Code",
            "type": "string"
          },
          "course_name": {
            "title": "Course Name",
            "type": "string"
          },
          "kind": {
            "description": "DIRECT: môn đang xét đòi trực tiếp; TRANSITIVE: đòi gián tiếp",
            "enum": [
              "DIRECT",
              "TRANSITIVE"
            ],
            "title": "Kind",
            "type": "string"
          },
          "path": {
            "description": "Chuỗi mã môn từ môn đang xét tới môn còn thiếu (đường ngắn nhất)",
            "items": {
              "type": "string"
            },
            "title": "Path",
            "type": "array"
          },
          "required_by": {
            "description": "Mã môn trực tiếp đòi hỏi môn này",
            "title": "Required By",
            "type": "string"
          }
        },
        "required": [
          "course_code",
          "course_name",
          "kind",
          "required_by",
          "path"
        ],
        "title": "MissingCourseOut",
        "type": "object"
      },
      "OrGroupExplainOut": {
        "properties": {
          "group_no": {
            "title": "Group No",
            "type": "integer"
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/OrOptionOut"
            },
            "title": "Options",
            "type": "array"
          },
          "required_by": {
            "description": "Mã môn có nhóm 'hoặc' này",
            "title": "Required By",
            "type": "string"
          }
        },
        "required": [
          "group_no",
          "required_by",
          "options"
        ],
        "title": "OrGroupExplainOut",
        "type": "object"
      },
      "OrGroupOut": {
        "properties": {
          "group_no": {
            "title": "Group No",
            "type": "integer"
          },
          "options": {
            "items": {
              "type": "string"
            },
            "title": "Options",
            "type": "array"
          }
        },
        "required": [
          "group_no",
          "options"
        ],
        "title": "OrGroupOut",
        "type": "object"
      },
      "OrOptionOut": {
        "properties": {
          "can_take_now": {
            "description": "Đã đủ điều kiện học lựa chọn này ngay",
            "title": "Can Take Now",
            "type": "boolean"
          },
          "course_code": {
            "title": "Course Code",
            "type": "string"
          },
          "course_name": {
            "title": "Course Name",
            "type": "string"
          },
          "missing_courses": {
            "description": "Mã các môn còn thiếu để học được lựa chọn này",
            "items": {
              "type": "string"
            },
            "title": "Missing Courses",
            "type": "array"
          }
        },
        "required": [
          "course_code",
          "course_name",
          "can_take_now",
          "missing_courses"
        ],
        "title": "OrOptionOut",
        "type": "object"
      },
      "PrerequisiteCheckResponse": {
        "properties": {
          "course_code": {
            "title": "Course Code",
            "type": "string"
          },
          "course_id": {
            "title": "Course Id",
            "type": "integer"
          },
          "eligible": {
            "title": "Eligible",
            "type": "boolean"
          },
          "missing_courses": {
            "items": {
              "type": "string"
            },
            "title": "Missing Courses",
            "type": "array"
          },
          "unmet_or_groups": {
            "items": {
              "$ref": "#/components/schemas/OrGroupOut"
            },
            "title": "Unmet Or Groups",
            "type": "array"
          }
        },
        "required": [
          "course_id",
          "course_code",
          "eligible",
          "missing_courses",
          "unmet_or_groups"
        ],
        "title": "PrerequisiteCheckResponse",
        "type": "object"
      },
      "PrerequisiteExplainRequest": {
        "properties": {
          "course_id": {
            "description": "Môn cần giải thích",
            "exclusiveMinimum": 0.0,
            "title": "Course Id",
            "type": "integer"
          },
          "student_id": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Chỉ admin được hỏi cho sinh viên khác",
            "title": "Student Id"
          }
        },
        "required": [
          "course_id"
        ],
        "title": "PrerequisiteExplainRequest",
        "type": "object"
      },
      "PrerequisiteExplainResponse": {
        "properties": {
          "course_code": {
            "title": "Course Code",
            "type": "string"
          },
          "course_id": {
            "title": "Course Id",
            "type": "integer"
          },
          "course_name": {
            "title": "Course Name",
            "type": "string"
          },
          "eligible": {
            "title": "Eligible",
            "type": "boolean"
          },
          "missing": {
            "items": {
              "$ref": "#/components/schemas/MissingCourseOut"
            },
            "title": "Missing",
            "type": "array"
          },
          "suggested_order": {
            "description": "Thứ tự học gợi ý cho các môn bắt buộc còn thiếu",
            "items": {
              "type": "string"
            },
            "title": "Suggested Order",
            "type": "array"
          },
          "total_missing": {
            "description": "Tổng số môn bắt buộc còn thiếu",
            "title": "Total Missing",
            "type": "integer"
          },
          "truncated": {
            "description": "True nếu danh sách bị cắt bớt theo PREREQ_EXPLAIN_MAX_ITEMS",
            "title": "Truncated",
            "type": "boolean"
          },
          "unmet_or_groups": {
            "items": {
              "$ref": "#/components/schemas/OrGroupExplainOut"
            },
            "title": "Unmet Or Groups",
            "type": "array"
          }
        },
        "required": [
          "course_id",
          "course_code",
          "course_name",
          "eligible",
          "missing",
          "unmet_or_groups",
          "suggested_order",
          "total_missing",
          "truncated"
        ],
        "title": "PrerequisiteExplainResponse",
        "type": "object"
      },
      "RefreshRequest": {
        "properties": {
          "refresh_token": {
            "minLength": 1,
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "RefreshRequest",
        "type": "object"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "token_type": {
            "const": "bearer",
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "expires_in",
          "user"
        ],
        "title": "TokenResponse",
        "type": "object"
      },
      "UserOut": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "max_credits": {
            "title": "Max Credits",
            "type": "integer"
          },
          "mssv": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mssv"
          },
          "role": {
            "enum": [
              "student",
              "admin"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "full_name",
          "role",
          "mssv",
          "max_credits"
        ],
        "title": "UserOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "University Course Registration API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/courses": {
      "get": {
        "description": "Lấy danh sách học phần (phân trang, tìm kiếm).",
        "operationId": "list_courses_api_v1_admin_courses_get",
        "parameters": [
          {
            "description": "Tìm kiếm theo mã hoặc tên môn học",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Tìm kiếm theo mã hoặc tên môn học",
              "title": "Q"
            }
          },
          {
            "description": "Trang hiện tại (bắt đầu từ 1)",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "description": "Trang hiện tại (bắt đầu từ 1)",
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "description": "Số lượng mỗi trang (tối đa 100)",
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "default": 20,
              "description": "Số lượng mỗi trang (tối đa 100)",
              "maximum": 100,
              "minimum": 1,
              "title": "Page Size",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Courses",
        "tags": [
          "admin-courses"
        ]
      },
      "post": {
        "description": "Tạo mới một học phần. Báo 409 ALREADY_EXISTS nếu trùng mã.",
        "operationId": "create_course_api_v1_admin_courses_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CourseCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Course",
        "tags": [
          "admin-courses"
        ]
      }
    },
    "/api/v1/admin/courses/{course_id}": {
      "delete": {
        "description": "Xóa học phần. Nếu đang có tham chiếu (lớp học, tiên quyết, điểm), trả 409 IN_USE.",
        "operationId": "delete_course_api_v1_admin_courses__course_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "course_id",
            "required": true,
            "schema": {
              "title": "Course Id",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Course",
        "tags": [
          "admin-courses"
        ]
      },
      "get": {
        "description": "Lấy thông tin chi tiết một học phần.",
        "operationId": "get_course_api_v1_admin_courses__course_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "course_id",
            "required": true,
            "schema": {
              "title": "Course Id",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Course",
        "tags": [
          "admin-courses"
        ]
      },
      "put": {
        "description": "Cập nhật thông tin học phần.",
        "operationId": "update_course_api_v1_admin_courses__course_id__put",
        "parameters": [
          {
            "in": "path",
            "name": "course_id",
            "required": true,
            "schema": {
              "title": "Course Id",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CourseUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Update Course",
        "tags": [
          "admin-courses"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "Thu hồi refresh token khi đăng xuất.",
        "operationId": "logout_api_v1_auth_logout_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            },

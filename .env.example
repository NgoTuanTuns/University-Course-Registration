APP_ENV=dev
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

POSTGRES_USER=course_user
# Example placeholder for local development; not a real secret.
POSTGRES_PASSWORD=example
POSTGRES_DB=course_reg
TEST_POSTGRES_DB=course_reg_test
# Example placeholder for local development; not a real secret.
DATABASE_URL=postgresql+asyncpg://course_user:example@db:5432/course_reg
# Example placeholder for local development; not a real secret.
TEST_DATABASE_URL=postgresql+asyncpg://course_user:example@db:5432/course_reg_test

REDIS_URL=redis://redis:6379/0
TEST_REDIS_URL=redis://redis:6379/1

JWT_SECRET=doi_thanh_chuoi_bi_mat_dai_ngau_nhien
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=7

DEFAULT_MAX_CREDITS=25
WAITLIST_MAX_RATIO=0.2
# M3: DB locks always apply; enable Redis admission only after measuring load.
MIN_BREAK_MINUTES=0
ENROLLMENT_REDIS_LOCK_ENABLED=false
LOCK_SEAT_THRESHOLD=3
ENROLLMENT_LOCK_TTL_MS=5000
ENROLLMENT_LOCK_WAIT_SEC=1.5
ENROLLMENT_IDEMPOTENCY_TTL_SEC=600
PREREQ_CACHE_TTL_SEC=600
# Engine tiên quyết (M2): TTL khóa đồ thị prereqgraph:v1, khóa chống dựng lại đồng loạt,
# giới hạn tần suất check/explain cho mỗi người dùng, số phần tử tối đa trong explain.
PREREQ_GRAPH_CACHE_TTL_SEC=3600
PREREQ_GRAPH_LOCK_TTL_SEC=5
PREREQ_RATE_LIMIT_PER_MIN=120
PREREQ_EXPLAIN_MAX_ITEMS=50
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Rate limit /auth/login (M4). Đặt false hoặc APP_ENV=loadtest để tắt khi test tải.
RATE_LIMIT_ENABLED=true
# Chỉ dùng khi chạy pytest local không có DB/Redis: bỏ qua guard DB và Alembic trong conftest.
# UNIT_TESTS_ONLY=1

VITE_API_BASE_URL=/api/v1
VITE_WEEK=3
VITE_USE_MOCK=false


